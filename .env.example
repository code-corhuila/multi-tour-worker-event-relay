# Variables the relay reads: the shared runtime ones (plan D-01) and its own.
BATCH_SIZE=100
RUN_TIMEOUT=30s
HTTP_TIMEOUT=5s
HTTP_ATTEMPTS=3
# time between two runs (ADR-004 D10)
RELAY_INTERVAL=5s
# where the health endpoint listens
HEALTH_ADDR=:8080
# internal base URLs on the platform network: no trailing path, no credentials
SECURITY_BASE_URL=http://security:8086
IDENTITY_AUDIT_BASE_URL=http://identity-audit-api:8082
# issued by the identity service, never versioned
SERVICE_TOKEN=
